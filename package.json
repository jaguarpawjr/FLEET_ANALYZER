{
  "name": "fleet-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
 "scripts": {
  "cleaning": "tsx scripts/cleaning.ts",
  "pipeline": "tsx scripts/pipeline.ts",
  "api": "tsx src/server.ts",
  "start": "npm run api",
  "build": "tsc -p tsconfig.json && vite build",
  "test": "vitest run --config vitest.config.ts",
  "cdk": "cdk",
  "cdk:test": "vitest run infra/fleet-analytics-stack.test.ts",
  "cdk:synth": "cdk synth",
  "dev": "npm run cleaning && npm run pipeline && concurrently \"npm:api\" \"vite --host 0.0.0.0\""
},
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "aws-cdk": "^2.1100.0",
    "concurrently": "^9.2.1",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
